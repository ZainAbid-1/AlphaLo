# =============================================
# AlphaLo Node.js Server — Environment Variables
# Copy this to .env and fill in your values
# =============================================

# MongoDB Atlas connection string
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/alphalo_db?appName=Cluster0

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<your-supabase-service-role-key>
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>

# URL of the deployed Python FastAPI service on Render
PYTHON_SERVICE_URL=https://<your-python-service>.onrender.com

# Admin whitelist (comma-separated emails)
ALLOWED_ADMIN_EMAILS=admin@example.com,admin2@example.com

# CORS: comma-separated list of allowed frontend origins
# Add your Vercel URL here after deploying
ALLOWED_ORIGINS=https://<your-app>.vercel.app,http://localhost:5173

# Port (Render sets this automatically — leave as 5000 for local)
PORT=5000
