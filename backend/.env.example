# =============================================
# AlphaLo Python FastAPI — Environment Variables
# Copy this to .env and fill in your values
# =============================================

# AI Provider: "openai" or "groq"
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL_NAME=gpt-4o-mini

# Groq (optional, only if AI_PROVIDER=groq)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Pinecone
PINECONE_API_KEY=pcsk_...

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<your-supabase-service-role-key>
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>

# Admin whitelist (comma-separated emails)
ALLOWED_ADMIN_EMAILS=admin@example.com,admin2@example.com

# MongoDB Atlas
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/alphalo_db?appName=Cluster0

# Redis (Upstash)
REDIS_URL=rediss://default:<password>@<host>:6379

# CORS: comma-separated list of allowed frontend origins
# Add your Vercel URL here after deploying
ALLOWED_ORIGINS=https://<your-app>.vercel.app,http://localhost:5173
