# =============================================
# AlphaLo Frontend — Environment Variables
# Copy this to .env and fill in your values
# =============================================

# Supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Admin whitelist (comma-separated emails)
VITE_ALLOWED_ADMIN_EMAILS=admin@example.com,admin2@example.com

# URL of the deployed Node.js Express server on Render
VITE_SERVER_URL=https://<your-node-server>.onrender.com

# URL of the deployed Python FastAPI service on Render
VITE_PYTHON_URL=https://<your-python-service>.onrender.com
